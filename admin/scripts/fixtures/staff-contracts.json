{
  "ShopItemUpdateRequest": {
    "additionalProperties": false,
    "properties": {
      "name": {
        "anyOf": [
          {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Name"
      },
      "price_coins": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Price Coins"
      },
      "asset_url": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Asset Url"
      },
      "is_available": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Is Available"
      },
      "rarity": {
        "anyOf": [
          {
            "enum": [
              "common",
              "rare",
              "epic",
              "legendary"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Rarity"
      },
      "character_name": {
        "anyOf": [
          {
            "maxLength": 100,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Character Name"
      },
      "series_title": {
        "anyOf": [
          {
            "maxLength": 255,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Series Title"
      },
      "webtoon_id": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Webtoon Id"
      }
    },
    "title": "ShopItemUpdateRequest",
    "type": "object"
  },
  "ChapterUpdateRequest": {
    "additionalProperties": false,
