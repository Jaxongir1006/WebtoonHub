  "PoolCreateRequest": {
    "$defs": {
      "PoolCardInput": {
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "exclusiveMinimum": 0,
            "title": "Item Id",
            "type": "integer"
          },
          "weight": {
            "default": 1,
            "maximum": 1000000,
            "minimum": 1,
            "title": "Weight",
            "type": "integer"
          }
        },
        "required": [
          "item_id"
        ],
        "title": "PoolCardInput",
        "type": "object"
      },
      "RarityWeights": {
        "additionalProperties": false,
        "properties": {
          "common": {
            "default": 70,
            "maximum": 1000000,
            "minimum": 0,
            "title": "Common",
            "type": "integer"
          },
          "rare": {
            "default": 22,
            "maximum": 1000000,
            "minimum": 0,
            "title": "Rare",
            "type": "integer"
          },
          "epic": {
            "default": 7,
            "maximum": 1000000,
            "minimum": 0,
            "title": "Epic",
            "type": "integer"
          },
          "legendary": {
            "default": 1,
            "maximum": 1000000,
            "minimum": 0,
            "title": "Legendary",
            "type": "integer"
          }
        },
        "title": "RarityWeights",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "title": {
        "maxLength": 100,
        "minLength": 1,
        "title": "Title",
        "type": "string"
      },
      "description": {
        "anyOf": [
          {
            "maxLength": 5000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Description"
      },
      "cost_coins": {
        "default": 100,
        "maximum": 1000000,
        "minimum": 1,
        "title": "Cost Coins",
        "type": "integer"
      },
      "is_active": {
        "default": false,
        "title": "Is Active",
        "type": "boolean"
      },
      "rarity_weights": {
        "$ref": "#/$defs/RarityWeights"
      },
      "cards": {
        "items": {
          "$ref": "#/$defs/PoolCardInput"
        },
        "maxItems": 500,
        "title": "Cards",
        "type": "array"
      }
    },
    "required": [
      "title"
    ],
    "title": "PoolCreateRequest",
    "type": "object"
  },
