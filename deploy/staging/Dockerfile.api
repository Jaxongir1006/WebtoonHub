FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini
COPY backend/scripts/bootstrap_admin.py ./scripts/bootstrap_admin.py
COPY backend/scripts/prune_orphan_media.py ./scripts/prune_orphan_media.py
COPY backend/scripts/prune_chapter_imports.py ./scripts/prune_chapter_imports.py
RUN mkdir -p ./public_content ./private_chapter_imports

EXPOSE 8000
CMD ["sh", "-c", "python -m alembic upgrade head && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=*"]
