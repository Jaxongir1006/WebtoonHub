# Copy to .env.local. Keep .env.local out of source control.
# This file collects setup values; it is not the backend's runtime .env.
# Session pooler URI, keeping [YOUR-PASSWORD] as a placeholder:
SUPABASE_DATABASE_CONNECTION=''
SUPABASE_DATABASE_PASSWORD=''
SUPABASE_URL='https://your-project-ref.supabase.co'
# Backend-only key from Supabase Settings > API Keys > Secret keys:
SUPABASE_SECRET_KEY=''
STORAGE_BUCKET_MEDIA='webtoonhub-media'
STORAGE_BUCKET_IMPORTS='webtoonhub-imports'
