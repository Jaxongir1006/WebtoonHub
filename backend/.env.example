# --- APP CONFIG ---
APP_NAME=WebtoonHub
APP_ENV=development
DEBUG=false
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174"]
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_ACCOUNTS=false
SEED_DEMO_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- DATABASE (POSTGRESQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webtoonhub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/webtoonhub

# --- CACHE (REDIS) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- STORAGE (MINIO / S3) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_COVERS=webtoon-covers
MINIO_BUCKET_CHAPTERS=chapter-images
MINIO_BUCKET_SHOP=shop-assets
MINIO_SECURE=false

# --- SMTP (MAILPIT / PRODUCTION SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@webtoonhub.uz
SMTP_FROM_NAME=WebtoonHub
SMTP_TLS=false
